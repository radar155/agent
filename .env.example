# ╔══════════════════════════════════════════════════╗
# ║              MODEL PROVIDER                      ║
# ╚══════════════════════════════════════════════════╝
# Options: "anthropic" | "openai"
MODEL_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# ╔══════════════════════════════════════════════════╗
# ║              TOOL GROUPS                         ║
# ╚══════════════════════════════════════════════════╝
# Each group can be enabled/disabled (true/false). All enabled by default.
#
# sandbox — bash, view, create_file, str_replace, present_files
#   Gives the agent access to shell execution and file operations.
#   When enabled, configure the Sandbox section below.
TOOLS_SANDBOX=true
#
# web — web_fetch
#   Allows the agent to fetch and extract content from URLs.
TOOLS_WEB=true
#
# output — chart, html_render
#   Visual output tools for the frontend (charts, custom HTML).
TOOLS_OUTPUT=true

# ╔══════════════════════════════════════════════════╗
# ║         SANDBOX (only when TOOLS_SANDBOX=true)   ║
# ╚══════════════════════════════════════════════════╝
# Options: "local" (direct filesystem) | "docker" (isolated container)
SANDBOX_MODE=local
SANDBOX_WORKING_DIR=./workspace
SANDBOX_TIMEOUT=30000

# Docker settings (only when SANDBOX_MODE=docker)
DOCKER_IMAGE=agent-sandbox
DOCKER_CONTAINER_NAME=agent-sandbox
DOCKER_HOST_WORKSPACE=./workspace
DOCKER_CONTAINER_WORKSPACE=/workspace

# ╔══════════════════════════════════════════════════╗
# ║              FILE SYSTEM                         ║
# ╚══════════════════════════════════════════════════╝
WORKSPACE_PATH=./workspace
OUTPUTS_PATH=./outputs
MAX_FILE_SIZE=104857600

# ╔══════════════════════════════════════════════════╗
# ║              SERVER                              ║
# ╚══════════════════════════════════════════════════╝
PORT=3000

# ╔══════════════════════════════════════════════════╗
# ║              MEMORY / CHECKPOINTER               ║
# ╚══════════════════════════════════════════════════╝
# Options: "memory" | "sqlite" | "postgres"
CHECKPOINTER_TYPE=memory
SQLITE_DB_PATH=./data/checkpoints.db
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
