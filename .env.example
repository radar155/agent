# === Model Provider ===
# Options: "anthropic" | "openai"
MODEL_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# === Sandbox ===
# Options: "local" | "docker"
SANDBOX_MODE=local
SANDBOX_WORKING_DIR=./workspace
SANDBOX_TIMEOUT=30000

# === Docker (only when SANDBOX_MODE=docker) ===
DOCKER_IMAGE=agent-sandbox
DOCKER_CONTAINER_NAME=agent-sandbox
DOCKER_HOST_WORKSPACE=./workspace
DOCKER_CONTAINER_WORKSPACE=/workspace

# === File System ===
WORKSPACE_PATH=./workspace
OUTPUTS_PATH=./outputs
MAX_FILE_SIZE=104857600

# === Server ===
PORT=3000

# === Memory / Checkpointer ===
# Options: "memory" | "sqlite" | "postgres"
CHECKPOINTER_TYPE=memory
SQLITE_DB_PATH=./data/checkpoints.db
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
